# Copy this file to .env (same folder) and fill in the keys. .env is git-ignored;
# never commit real keys. Restart the app after changing it.

# --- Claude: resume tailoring and interview assessment ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_RESUMES_PER_RUN=8

# --- Adzuna: job search beyond the company watchlist (free developer key) ---
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- App storage (defaults shown) ---
DATABASE_URL=sqlite:///data/job_search.db
TRACKER_PATH=data/tracker_template.xlsx
